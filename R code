entropy <- function(post) { K <- ncol(post); if (K == 1) return(NA)
  p <- pmax(post, 1e-12); 1 - sum(-p * log(p)) / (nrow(post) * log(K)) }

lca_em <- function(Y, K, nrep = 10, maxit = 3000, tol = 1e-7) {          # Route B: own EM (handles NA)
  Y <- as.matrix(Y); N <- nrow(Y); J <- ncol(Y); R <- apply(Y, 2, max, na.rm = TRUE)
  best <- NULL
  for (r in seq_len(nrep)) {
    set.seed(1000 + r)
    pi <- rep(1 / K, K)
    th <- lapply(seq_len(J), function(j) { m <- matrix(stats::runif(K * R[j]), K, R[j]); m / rowSums(m) })
    ll_old <- -Inf
    for (it in seq_len(maxit)) {
      lp <- matrix(log(pi), N, K, byrow = TRUE)                          # log P(class)
      for (j in seq_len(J)) { y <- Y[, j]; ok <- !is.na(y)
        lp[ok, ] <- lp[ok, ] + t(log(th[[j]][, y[ok], drop = FALSE])) }  # contribution of observed items
      mx <- apply(lp, 1, max); ll <- sum(mx + log(rowSums(exp(lp - mx))))
      post <- exp(lp - mx); post <- post / rowSums(post)                 # E step
      pi <- colMeans(post)                                               # M step: class shares
      for (j in seq_len(J)) { y <- Y[, j]; ok <- !is.na(y)
        m <- sapply(seq_len(R[j]), function(cc) colSums(post[ok & y == cc, , drop = FALSE]))
        m <- matrix(m, K, R[j]) + 1e-10; th[[j]] <- m / rowSums(m) }     # M step: item probabilities
      if (abs(ll - ll_old) < tol) break; ll_old <- ll
    }
    if (is.null(best) || ll > best$ll) best <- list(ll = ll, P = pi, th = th, post = post)
  }
  npar <- (K - 1) + K * sum(R - 1)
  best$bic <- -2 * best$ll + log(N) * npar; best$aic <- -2 * best$ll + 2 * npar; best$npar <- npar
  best$yol <- "B_kendiEM"; best
}
run_lca <- function(Y, K, nrep = 10) {                                              # Route A: poLCA; otherwise Route B
  df <- as.data.frame(Y); f <- stats::as.formula(paste0("cbind(", paste(names(df), collapse = ","), ") ~ 1"))
  fit <- tryCatch(suppressWarnings(poLCA::poLCA(f, df, nclass = K, nrep = nrep, maxiter = 3000,
                                                na.rm = FALSE, verbose = FALSE, calc.se = FALSE)),
                  error = function(e) NULL)
  if (!is.null(fit) && nrow(fit$posterior) == nrow(df))
    return(list(ll = fit$llik, P = fit$P, th = fit$probs, post = fit$posterior,
                bic = fit$bic, aic = fit$aic, npar = fit$npar, yol = "A_poLCA"))
  lca_em(Y, K, nrep = nrep)
}

ari <- function(a, b) {                                                  # adjusted Rand index
  t <- table(a, b); n <- sum(t); s <- function(x) sum(choose(x, 2))
  e <- s(rowSums(t)) * s(colSums(t)) / choose(n, 2)
  (s(t) - e) / ((s(rowSums(t)) + s(colSums(t))) / 2 - e) }

