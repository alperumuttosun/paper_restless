read_sav_safe <- function(f) {                                          # Route A: SPSS (with value labels)
  if (is.na(f)) return(NULL)
  d <- tryCatch(haven::read_sav(f), error = function(e)
         tryCatch(haven::read_sav(f, encoding = "latin1"), error = function(e2) NULL))
  if (is.null(d)) NULL else clean_df(as.data.frame(d))
}
read_csv_safe <- function(f) {                                          # Route B: CSV
  if (is.na(f)) return(NULL)
  d <- tryCatch(data.table::fread(f, encoding = "UTF-8", na.strings = c("", "NA")),
                error = function(e) tryCatch(data.table::fread(f, encoding = "Latin-1", na.strings = c("", "NA")),
                                             error = function(e2) NULL))
  if (is.null(d)) NULL else clean_df(as.data.frame(d))
}
