# ---------- gradient for any item set ----------
grad_gen <- function(ft, Y, iA, wt = NULL, thr = THR6, key = "N_PC") {
  N <- nrow(ft$post); if (is.null(wt)) wt <- rep(1, N); wt[is.na(wt)] <- 0
  q <- which(colnames(Y)[iA] == key)
  if (!length(q)) q <- which(colnames(Y)[iA] == "N_Internet")           # use internet need if the computer item is dropped
  pk <- ft$thA[[q]][, 2]
  man <- which(pk < thr); if (!length(man) || length(man) == ft$Ka) man <- which.min(pk)
  bs <- shift_b(ft); isM <- ft$aOf %in% man
  pa_m <- sum(wt * rowSums(ft$post[, isM, drop = FALSE])); pa_o <- sum(wt * rowSums(ft$post[, !isM, drop = FALSE]))
  pab_m <- sum(wt * rowSums(ft$post[, isM & ft$bOf == bs, drop = FALSE]))
  pab_o <- sum(wt * rowSums(ft$post[, !isM & ft$bOf == bs, drop = FALSE]))
  c(P_aktaran_el = pab_m / pa_m, P_aktaran_diger = pab_o / pa_o, gradyan = pab_m / pa_m - pab_o / pa_o,
    el_payi = pa_m / sum(wt), n_el_sinif = length(man), ayirici = q)
}
# person level: probability of the cost-shifting regime and of a manual profile
person_probs <- function(ft, Y, iA, thr = THR6) {
  pk <- ft$thA[[which(colnames(Y)[iA] == "N_PC")]][, 2]
  man <- which(pk < thr); if (!length(man)) man <- which.min(pk)
  bs <- shift_b(ft)
  list(p_shift = rowSums(ft$post[, ft$bOf == bs, drop = FALSE]),          # P(cost-shifting regime | responses)
       p_man = rowSums(ft$post[, ft$aOf %in% man, drop = FALSE]))         # P(manual profile | responses)
}
fit_summary <- function(f, Y, nm, iA, iB) {
  m <- list(A = sapply(seq_len(f$Ka), function(a) sum(f$P[f$aOf == a])),
            B = sapply(seq_len(f$Kb), function(b) sum(f$P[f$bOf == b])))
  data.frame(model = nm, Ka = f$Ka, Kb = f$Kb, LL = f$ll, npar = f$npar, BIC = f$bic, entropi = entropy(f$post),
             en_kucuk_A = min(m$A), en_kucuk_B = min(m$B), t(bvr_sum(bvr_fun(Y, f))), t(grad_gen(f, Y, iA)))
}

