# ---------- 11b. bootstrap (with checkpoints) ----------
if (!file.exists("step11_bootstrap_ci.csv")) {
  isco <- suppressWarnings(as.numeric(as.character(w$ISCO_1D)))
  init11 <- list(P = f11$P, thA = f11$thA, thB = f11$thB)
  fpart <- "step11_bootstrap_tekrarlar.csv"
  done <- if (file.exists(fpart)) rd(fpart) else NULL                    # resume from a previous run
  start_b <- if (is.null(done)) 1 else max(done$tekrar) + 1
  buf <- list(); t0 <- Sys.time()
  if (start_b <= B11) for (b in start_b:B11) {
    set.seed(61000 + b); idx <- sample.int(nrow(YC5), replace = TRUE)   # first 500 replicates as in step10
    fb <- tryCatch(lca2d_em(YC5[idx, ], iA5, iB5, KA11, KB11, nrep = 1, init = init11, tol = 1e-6), error = function(e) NULL)  # Route A
    if (is.null(fb)) fb <- tryCatch(lca2d_em(YC5[idx, ], iA5, iB5, KA11, KB11, nrep = 3, tol = 1e-6), error = function(e) NULL) # Route B
    if (!is.null(fb)) {
      g <- grad3(fb, YC5, iA5); pb <- person_probs(fb, YC5, iA5); ib <- isco[idx]
      dI <- mean(pb$p_shift[!is.na(ib) & ib >= 5]) - mean(pb$p_shift[!is.na(ib) & ib >= 1 & ib <= 4])
      buf[[length(buf) + 1]] <- data.frame(tekrar = b, gradyan_ana = g[["gradyan_ana"]], P_aktaran_el = g[["P_aktaran_el"]],
        P_aktaran_diger = g[["P_aktaran_diger"]], gradyan_dar = g[["gradyan_dar"]], gradyan_dijital = g[["gradyan_dijital"]],
        ISCO_5_9_vs_1_4 = dI)
    }
    if (b %% 25 == 0 || b == B11) {                                      # checkpoint
      if (length(buf)) { done <- rbind(done, do.call(rbind, buf)); buf <- list(); write_out(done, fpart) }
      message("step11 bootstrap ", b, "/", B11, " | ", round(difftime(Sys.time(), t0, units = "mins"), 1), " dk")
    }
  }
  bt <- rd(fpart); g0 <- grad3(f11, YC5, iA5); pp0 <- person_probs(f11, YC5, iA5)
  isco0 <- suppressWarnings(as.numeric(as.character(w$ISCO_1D)))
  est <- c(gradyan_ana = g0[["gradyan_ana"]], P_aktaran_el = g0[["P_aktaran_el"]], P_aktaran_diger = g0[["P_aktaran_diger"]],
           gradyan_dar = g0[["gradyan_dar"]], gradyan_dijital = g0[["gradyan_dijital"]],
           ISCO_5_9_vs_1_4 = mean(pp0$p_shift[!is.na(isco0) & isco0 >= 5]) - mean(pp0$p_shift[!is.na(isco0) & isco0 >= 1 & isco0 <= 4]))
  ci <- do.call(rbind, lapply(names(est), function(v) data.frame(olcu = v, tahmin = est[[v]], ort = mean(bt[[v]], na.rm = TRUE),
          SE = stats::sd(bt[[v]], na.rm = TRUE), lo_2.5 = stats::quantile(bt[[v]], .025, na.rm = TRUE),
          hi_97.5 = stats::quantile(bt[[v]], .975, na.rm = TRUE), pct_sifir_alti = 100 * mean(bt[[v]] <= 0, na.rm = TRUE),
          n_basarili = sum(!is.na(bt[[v]])))))
  write_out(rnd(ci), "step11_bootstrap_ci.csv")
}

