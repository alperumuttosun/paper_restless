prev_one <- function(expo, paid, th, wt = NULL) {                       # expo: exposed; paid: code 1-4
  u_all  <- ifelse(expo, paid >= th, FALSE)                              # merged: not exposed = paid
  u_all[expo & is.na(paid)] <- NA                                        # exposed but unanswered -> NA
  u_cond <- paid[expo] >= th                                             # conditional: exposed only
  r <- c(N_tum = sum(!is.na(u_all)), N_maruz = sum(expo),
         pct_tum = 100 * mean(u_all, na.rm = TRUE), pct_kosullu = 100 * mean(u_cond, na.rm = TRUE))
  if (!is.null(wt)) {                                                    # UK weighted version
    ok <- !is.na(u_all) & !is.na(wt); okc <- expo & !is.na(paid) & !is.na(wt)
    r <- c(r, pct_tum_w = 100 * stats::weighted.mean(u_all[ok], wt[ok]),
              pct_kosullu_w = 100 * stats::weighted.mean(paid[okc] >= th, wt[okc]))
  } else r <- c(r, pct_tum_w = NA, pct_kosullu_w = NA)
  r
}
