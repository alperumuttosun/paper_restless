# True structure: need profile (digital / manual) and compensation class (generous / cost-shifting).
# Cost-shifting probability may depend on the profile (p_dig, p_man). Target: manual minus digital.
sim_one <- function(N, p_manual, p_dig, p_man, need_dig, need_man, un_gen, un_shift) {
  man <- stats::rbinom(N, 1, p_manual)                                             # true need profile
  sh  <- stats::rbinom(N, 1, ifelse(man == 1, p_man, p_dig))                       # true compensation class
  pn  <- t(sapply(man, function(m) if (m == 1) need_man else need_dig))            # need probabilities
  nd  <- matrix(stats::rbinom(N * 8, 1, pn), N, 8)                                  # item needed?
  un  <- matrix(stats::rbinom(N * 8, 1, ifelse(sh == 1, un_shift, un_gen)), N, 8)  # not paid?
  YMs <- ifelse(nd == 0, 1, un + 1)                                                  # merged
  YCs <- cbind(nd + 1, ifelse(nd == 1, un + 1, NA))                                   # conditional
  colnames(YMs) <- paste0("M", 1:8); colnames(YCs) <- c(paste0("N", 1:8), paste0("C", 1:8))
  list(man = man, sh = sh, YM = YMs, YC = YCs) }
