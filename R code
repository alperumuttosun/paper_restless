# ---------- 9a. measurement assumption ----------
# relaxed model: B item probabilities separate for the two need groups (manual / other)
lca2d_em_dif <- function(Y, idxA, idxB, Ka, Kb, gA, init, maxit = 3000, tol = 1e-7) {
  Y <- as.matrix(Y); N <- nrow(Y); R <- apply(Y, 2, max, na.rm = TRUE)
  C <- Ka * Kb; aOf <- rep(seq_len(Ka), times = Kb); bOf <- rep(seq_len(Kb), each = Ka)
  key <- (gA[aOf] - 1) * Kb + bOf                                        # cell -> (group, b) key
  pc <- init$P; thA <- init$thA
  thB <- lapply(init$thB, function(m) rbind(m, m))                       # both groups start from the same values
  ll_old <- -Inf
  for (it in seq_len(maxit)) {
    LA <- matrix(0, N, Ka); LB <- matrix(0, N, 2 * Kb)
    for (q in seq_along(idxA)) { y <- Y[, idxA[q]]; ok <- !is.na(y); LA[ok, ] <- LA[ok, ] + t(log(thA[[q]][, y[ok], drop = FALSE])) }
    for (q in seq_along(idxB)) { y <- Y[, idxB[q]]; ok <- !is.na(y); LB[ok, ] <- LB[ok, ] + t(log(thB[[q]][, y[ok], drop = FALSE])) }
    lp <- LA[, aOf, drop = FALSE] + LB[, key, drop = FALSE] + matrix(log(pc), N, C, byrow = TRUE)
    mx <- apply(lp, 1, max); ll <- sum(mx + log(rowSums(exp(lp - mx))))
    post <- exp(lp - mx); post <- post / rowSums(post); pc <- colMeans(post)
    pA <- sapply(seq_len(Ka), function(a) rowSums(post[, aOf == a, drop = FALSE]))
    pK <- sapply(seq_len(2 * Kb), function(k) rowSums(post[, key == k, drop = FALSE]))
    thA <- lapply(seq_along(idxA), function(q) { y <- Y[, idxA[q]]; ok <- !is.na(y)
      m <- sapply(seq_len(R[idxA[q]]), function(cc) colSums(pA[ok & y == cc, , drop = FALSE])); m <- matrix(m, Ka) + 1e-10; m / rowSums(m) })
    thB <- lapply(seq_along(idxB), function(q) { y <- Y[, idxB[q]]; ok <- !is.na(y)
      m <- sapply(seq_len(R[idxB[q]]), function(cc) colSums(pK[ok & y == cc, , drop = FALSE])); m <- matrix(m, 2 * Kb) + 1e-10; m / rowSums(m) })
    if (abs(ll - ll_old) < tol) break; ll_old <- ll
  }
  npar <- (C - 1) + Ka * sum(R[idxA] - 1) + 2 * Kb * sum(R[idxB] - 1)
  list(ll = ll, P = pc, post = post, thA = thA, thB = thB, npar = npar, bic = -2 * ll + log(N) * npar,
       aOf = aOf, bOf = bOf, key = key, Ka = Ka, Kb = Kb)
}
