needs_boot <- function(fn, B = B_ALL) {                                  # TRUE if the file is missing or used a different B
  if (!file.exists(fn)) return(TRUE)
  d <- tryCatch(rd(fn), error = function(e) NULL)
  is.null(d) || !("n_boot" %in% names(d)) || !isTRUE(all(d$n_boot == B))
}

grad_old <- function(ft, Y, iA) {                                        # narrow definition: single class with the lowest computer need
  pk <- ft$thA[[which(colnames(Y)[iA] == "N_PC")]][, 2]; man <- which.min(pk); bs <- shift_b(ft)
  isM <- ft$aOf %in% man
  sum(ft$P[isM & ft$bOf == bs]) / sum(ft$P[isM]) - sum(ft$P[!isM & ft$bOf == bs]) / sum(ft$P[!isM])
}
info_crit <- function(f, N) {                                            # information criteria
  EN <- -sum(f$post * log(pmax(f$post, 1e-300)))                         # classification entropy (raw)
  c(AIC = -2 * f$ll + 2 * f$npar, AIC3 = -2 * f$ll + 3 * f$npar, CAIC = -2 * f$ll + (log(N) + 1) * f$npar,
    SABIC = -2 * f$ll + log((N + 2) / 24) * f$npar, ICL_BIC = f$bic + 2 * EN)
}
