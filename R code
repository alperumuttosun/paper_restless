# ---------- 11f. measurement assumption ----------
if (!file.exists("step11_olcum_varsayimi.csv")) {
  man <- man_classes(f11, YC5, iA5, "ana"); gA <- ifelse(seq_len(f11$Ka) %in% man, 2, 1); bs <- shift_b(f11)
  pM <- rowSums(f11$post[, f11$aOf %in% man, drop = FALSE])
  res <- list()
  for (q in seq_along(iB5)) { j <- iB5[q]; y <- YC5[, j]; ok <- !is.na(y)
    for (b in seq_len(f11$Kb)) { pb <- rowSums(f11$post[, f11$bOf == b, drop = FALSE])
      wM <- (pb * pM)[ok]; wO <- (pb * (1 - pM))[ok]; u <- (y[ok] == 2)
      res[[length(res) + 1]] <- data.frame(madde = colnames(YC5)[j], B_sinif = b, aktaran = b == bs, model = f11$thB[[q]][b, 2],
        gozlenen_el = sum(wM * u) / sum(wM), gozlenen_diger = sum(wO * u) / sum(wO), n_etkin_el = sum(wM), n_etkin_diger = sum(wO)) } }
  res <- do.call(rbind, res); res$fark_el_diger <- res$gozlenen_el - res$gozlenen_diger
  write_out(rnd(res), "step11_artik_kontrol.csv")
  fd <- tryCatch(lca2d_em_dif(YC5, iA5, iB5, KA11, KB11, gA, init = list(P = f11$P, thA = f11$thA, thB = f11$thB)), error = function(e) NULL)  # Route A
  if (is.null(fd)) fd <- tryCatch({ set.seed(11090); jit <- lapply(f11$thB, function(m) { m <- m + matrix(stats::runif(length(m), 0, .02), nrow(m)); m / rowSums(m) })
    lca2d_em_dif(YC5, iA5, iB5, KA11, KB11, gA, init = list(P = f11$P, thA = f11$thA, thB = jit)) }, error = function(e) NULL)                    # Route B
  g0 <- grad_def(f11, YC5, iA5, "ana")
  oz <- data.frame(model = "6x5_esit_olcum", LL = f11$ll, npar = f11$npar, BIC = f11$bic, P_aktaran_el = g0[["P_aktaran_el"]],
                   P_aktaran_diger = g0[["P_aktaran_diger"]], gradyan = g0[["gradyan"]])
  if (!is.null(fd)) {
    isM <- fd$aOf %in% man
    oz <- rbind(oz, data.frame(model = "6x5_gevsetilmis", LL = fd$ll, npar = fd$npar, BIC = fd$bic,
      P_aktaran_el = sum(fd$P[isM & fd$bOf == bs]) / sum(fd$P[isM]), P_aktaran_diger = sum(fd$P[!isM & fd$bOf == bs]) / sum(fd$P[!isM]),
      gradyan = sum(fd$P[isM & fd$bOf == bs]) / sum(fd$P[isM]) - sum(fd$P[!isM & fd$bOf == bs]) / sum(fd$P[!isM])))
    th_d <- do.call(rbind, lapply(seq_along(iB5), function(q) data.frame(madde = colnames(YC5)[iB5[q]], B_sinif = seq_len(f11$Kb),
      P_odenmeyen_diger = fd$thB[[q]][seq_len(f11$Kb), 2], P_odenmeyen_el = fd$thB[[q]][f11$Kb + seq_len(f11$Kb), 2])))
    th_d$fark <- th_d$P_odenmeyen_el - th_d$P_odenmeyen_diger
    write_out(rnd(th_d), "step11_gevsetilmis_B.csv")
  }
  oz$LRT <- c(NA, if (nrow(oz) > 1) 2 * (oz$LL[2] - oz$LL[1])); oz$LRT_df <- c(NA, if (nrow(oz) > 1) oz$npar[2] - oz$npar[1])
  write_out(rnd(oz), "step11_olcum_varsayimi.csv")
}

