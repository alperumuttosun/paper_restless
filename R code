  g <- g[order(g$BIC), ]
  g$lab <- paste0(g$Ka, " x ", g$Kb); g$lab <- factor(g$lab, levels = rev(g$lab))
  defs <- c("Main: all need classes with computer need < 0.5", "Narrower: single lowest-computer-need class",
            "Digital: mean need for computer, phone and internet < 0.5")
  gl <- rbind(data.frame(lab = g$lab, Definition = defs[1], Gradient = g$gradyan_yeni),
              data.frame(lab = g$lab, Definition = defs[2], Gradient = g$gradyan_eski),
              data.frame(lab = g$lab, Definition = defs[3], Gradient = g$gradyan_dijital))
  gl <- gl[!is.na(gl$Gradient), ]; defs <- defs[defs %in% gl$Definition]; gl$Definition <- factor(gl$Definition, levels = defs)
  off <- if (length(defs) == 3) c(0.24, -0.24, 0) else c(0.17, -0.17)    # separate definitions vertically
  gl$y <- as.numeric(gl$lab) + off[as.integer(gl$Definition)]
  SEL_MODEL <- if (file.exists("step11_6x5_ozet.csv")) "6 x 5" else "5 x 4"  # main model row
  sel <- which(levels(g$lab) == SEL_MODEL)
  ok <- FALSE
  if (use_gg) ok <- tryCatch({
    p3 <- ggplot2::ggplot(gl, ggplot2::aes(x = Gradient, y = y, shape = Definition, colour = Definition)) +
      ggplot2::annotate("rect", xmin = -Inf, xmax = Inf, ymin = sel - 0.45, ymax = sel + 0.45, fill = "grey92") +
      ggplot2::geom_vline(xintercept = 0, linetype = 2, colour = "grey40") +
      ggplot2::geom_point(size = 2.6, stroke = 0.9) +
      ggplot2::scale_shape_manual(values = c(16, 8, 2)[seq_along(defs)]) +  # black circle / grey star / triangle
      ggplot2::scale_colour_manual(values = c("black", "grey55", "grey30")[seq_along(defs)]) +
      ggplot2::scale_y_continuous(breaks = seq_along(levels(g$lab)), labels = levels(g$lab), expand = ggplot2::expansion(add = 0.6)) +
      ggplot2::labs(x = "Need-profile gradient in cost-shifting", y = "Need x compensation classes (ordered by BIC)",
                    shape = NULL, colour = NULL) + th_fig(10) +
      ggplot2::theme(legend.position = "bottom", legend.direction = "vertical", panel.grid.minor.y = ggplot2::element_blank(),
                     legend.margin = ggplot2::margin(t = 6))
    save_gg(p3, "fig3_gradient_across_models", 6.5, 7); TRUE }, error = function(e) { message("Sekil 3 Yol A: ", conditionMessage(e)); FALSE })
  if (!ok) base_both("fig3_gradient_across_models", 6.5, 6, function() {
    graphics::par(mar = c(6, 7, 1, 1), mgp = c(3.5, 0.8, 0)); yy <- rev(seq_len(nrow(g)))  # best BIC at the top
    graphics::plot(g$gradyan_yeni, yy + 0.17, pch = 16, yaxt = "n", xlab = "Need-profile gradient", ylab = "",
                   xlim = range(c(0, g$gradyan_eski, g$gradyan_yeni), na.rm = TRUE), ylim = c(0.5, nrow(g) + 0.5))
    graphics::points(g$gradyan_eski, yy - 0.17, pch = 8, col = "grey55")
    if (any(!is.na(g$gradyan_dijital))) graphics::points(g$gradyan_dijital, yy, pch = 2, col = "grey30")
    graphics::axis(2, at = yy, labels = paste0(g$Ka, " x ", g$Kb), las = 1); graphics::abline(v = 0, lty = 2)
    graphics::legend("bottomright", c("Main definition", "Narrower definition", "Digital-need definition"), pch = c(16, 8, 2), col = c("black", "grey55", "grey30"), bty = "n") })
  message("Yazildi: fig3_gradient_across_models.png / .pdf")
}
