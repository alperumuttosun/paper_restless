# ---------- helper functions ----------
fix_utf8 <- function(x) {                                               # repair invalid UTF-8
  x <- as.character(x)
  bad <- !is.na(x) & !validUTF8(x)                                      # find invalid UTF-8 strings
  if (any(bad)) x[bad] <- iconv(x[bad], "latin1", "UTF-8", sub = "")    # re-encode from latin1
  x
}
clean_df <- function(d) {                                               # repair all character columns
  for (j in seq_along(d)) if (is.character(d[[j]])) d[[j]] <- fix_utf8(d[[j]])
  names(d) <- fix_utf8(names(d))
  d
}
write_out <- function(d, f) {                                           # write CSV (Excel-compatible, with BOM)
  ok <- tryCatch({ data.table::fwrite(d, f, bom = TRUE); TRUE },        # Route A: fwrite
                 error = function(e) FALSE)
  if (!ok) utils::write.csv(d, f, row.names = FALSE, fileEncoding = "UTF-8")  # Route B: write.csv
  message("Yazildi: ", f)
}
lab <- function(v) {                                                    # SPSS labels as "[code] label"
  if (inherits(v, "haven_labelled")) as.character(haven::as_factor(v, levels = "both"))
  else as.character(v)
}

