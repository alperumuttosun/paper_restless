bvr_fun <- function(Y, ft) {
  out <- list(); J <- ncol(Y)
  for (a in 1:(J - 1)) for (b in (a + 1):J) {
    ok <- !is.na(Y[, a]) & !is.na(Y[, b]); if (sum(ok) < 30) next
    if (sub("^._", "", colnames(Y)[a]) == sub("^._", "", colnames(Y)[b])) next   # N_/C_ pair of the same item
    O  <- table(factor(Y[ok, a], 1:2), factor(Y[ok, b], 1:2))
    pw <- colMeans(ft$post[ok, , drop = FALSE]); E <- matrix(0, 2, 2)
    for (k in seq_along(pw)) E <- E + pw[k] * outer(as.matrix(ft$th[[a]])[k, ], as.matrix(ft$th[[b]])[k, ])
    E <- E * sum(ok)
    out[[length(out) + 1]] <- data.frame(madde1 = colnames(Y)[a], madde2 = colnames(Y)[b], n = sum(ok),
                                         BVR = sum((O - E)^2 / pmax(E, 1e-8)))
  }
  out <- do.call(rbind, out); out[order(-out$BVR), ]
}
