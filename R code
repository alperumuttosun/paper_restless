    nm <- paste0("2B_A", Ka, "_B", Kb); fits4[[nm]] <- f2; bs <- bvr_sum(bvr_fun(YC2, f2))
    fs[[nm]] <- data.frame(model = nm, aile = "2B", Ka = Ka, Kb = Kb, LL = f2$ll, npar = f2$npar,
                           BIC = f2$bic, AIC = f2$aic, entropi = entropy(f2$post), en_kucuk_hucre = min(f2$P), t(bs))
  }
  for (K in 5:6) {                                                       # Route B: standard LCA
    fk <- run_lca(YC2, K, NREP4); nm <- paste0("Klasik_K", K); fits4[[nm]] <- fk; bs <- bvr_sum(bvr_fun(YC2, fk))
    fs[[nm]] <- data.frame(model = nm, aile = paste0("Klasik_", fk$yol), Ka = K, Kb = NA, LL = fk$ll, npar = fk$npar,
                           BIC = fk$bic, AIC = fk$aic, entropi = entropy(fk$post), en_kucuk_hucre = min(fk$P), t(bs))
  }
  fs <- do.call(rbind, fs); num <- sapply(fs, is.numeric); fs[num] <- lapply(fs[num], round, 3)
  write_out(fs, "step04_2d_uyum.csv")

  # best 2D model (BIC)
  f2s <- fs[fs$aile == "2B", ]
  if (nrow(f2s) == 0) stop("2B model kurulamadi.")
  bn <- f2s$model[which.min(f2s$BIC)]; fb <- fits4[[bn]]
  write_out(cbind(model = bn, bvr_fun(YC2, fb)), "step04_bvr_2d_best.csv")

  # 4b. Profiles: need probabilities in A classes, unpaid probabilities in B classes
  pA_marg <- sapply(seq_len(fb$Ka), function(a) sum(fb$P[fb$aOf == a]))
  pB_marg <- sapply(seq_len(fb$Kb), function(b) sum(fb$P[fb$bOf == b]))
  prA <- do.call(rbind, lapply(seq_along(iA), function(q) data.frame(boyut = "A_ihtiyac", madde = colnames(YC2)[iA[q]],
           sinif = seq_len(fb$Ka), sinif_payi = pA_marg, P_evet = fb$thA[[q]][, 2])))
  prB <- do.call(rbind, lapply(seq_along(iB), function(q) data.frame(boyut = "B_karsilama", madde = colnames(YC2)[iB[q]],
           sinif = seq_len(fb$Kb), sinif_payi = pB_marg, P_evet = fb$thB[[q]][, 2])))
  pr <- rbind(prA, prB); pr$model <- bn; num <- sapply(pr, is.numeric); pr[num] <- lapply(pr[num], round, 4)
  write_out(pr, "step04_2d_profil.csv")

  # 4c. Joint distribution and gradient: P(cost-shifting | need class)
  bs_id <- shift_b(fb); pcA <- which(colnames(YC2)[iA] == "N_PC")
  pPC <- fb$thA[[pcA]][, 2]; a_man <- which.min(pPC); a_dig <- which.max(pPC)
  grd <- do.call(rbind, lapply(seq_len(fb$Ka), function(a) data.frame(model = bn, A_sinif = a,
           A_payi = pA_marg[a], P_ihtiyac_PC = pPC[a],
           P_ihtiyac_Safety = fb$thA[[which(colnames(YC2)[iA] == "N_Safety")]][a, 2],
           P_aktaran_given_A = sum(fb$P[fb$aOf == a & fb$bOf == bs_id]) / pA_marg[a],
           el_emegi = a == a_man, dijital = a == a_dig)))
  grd$gradyan_el_eksi_dijital <- grd$P_aktaran_given_A[a_man] - grd$P_aktaran_given_A[a_dig]
  # fast uncertainty from posterior draws (200 replicates) instead of nonparametric bootstrap
  set.seed(77); cellmat <- fb$post
  bt <- replicate(200, {
    z <- apply(cellmat, 1, function(p) sample.int(length(p), 1, prob = p))   # draw a cell for each person
    a <- fb$aOf[z]; b <- fb$bOf[z]
    mean(b[a == a_man] == bs_id) - mean(b[a == a_dig] == bs_id) })
  grd$gradyan_lo <- stats::quantile(bt, .025); grd$gradyan_hi <- stats::quantile(bt, .975)
  num <- sapply(grd, is.numeric); grd[num] <- lapply(grd[num], round, 4)

  # 4d. ISCO composition of classes (posterior-weighted)
  pA <- matrix(sapply(seq_len(fb$Ka), function(a) rowSums(fb$post[, fb$aOf == a, drop = FALSE])), nrow(w), fb$Ka)
  pBs <- rowSums(fb$post[, fb$bOf == bs_id, drop = FALSE])
  isc <- as.character(w$ISCO_1D); isc[is.na(isc)] <- "NA"
  comp <- do.call(rbind, lapply(sort(unique(isc)), function(cat) {
    i <- isc == cat
    data.frame(ISCO_1D = cat, N = sum(i), t(setNames(100 * colSums(pA[i, , drop = FALSE]) / colSums(pA),
                                                    paste0("pct_A", seq_len(fb$Ka)))),
               pct_aktaran = 100 * sum(pBs[i]) / sum(pBs), pct_diger = 100 * sum(1 - pBs[i]) / sum(1 - pBs),
               P_aktaran_kategoride = mean(pBs[i])) }))
  num <- sapply(comp, is.numeric); comp[num] <- lapply(comp[num], round, 3)
  write_out(comp, "step04_2d_isco.csv")
  write_out(grd, "step04_2d_gradyan.csv")
}

# =====================================================================
# 4e. Monte Carlo: M (standard, K = 2), C (standard, K = 4), C-2D (Ka = 2, Kb = 2)
# =====================================================================
RUN_4MC <- !file.exists("step04_montecarlo.csv")
if (!RUN_4MC) message("step04 Monte Carlo ciktilari mevcut, atlandi.")
if (RUN_4MC) {
  mc4 <- list()
  for (s in seq_len(nrow(scen4))) for (r in seq_len(MC_R4)) {
    set.seed(9000 + 100 * s + r)
    sm  <- sim4(2952, scen4$p_manual[s], scen4$p_dig[s], scen4$p_man[s], scen4$un_gen[s], scen4$un_shift[s])
    gap <- function(p) mean(p[sm$man == 1]) - mean(p[sm$man == 0])      # manual minus digital
    fM <- run_lca(sm$YM, 2, NREP4_MC); fC <- run_lca(sm$YC, 4, NREP4_MC)
    f2 <- tryCatch(lca2d_em(sm$YC, 1:8, 9:16, 2, 2, nrep = NREP4_MC, maxit = 1500, tol = 1e-6),
                   error = function(e) NULL)
    g2 <- g2m <- NA
    if (!is.null(f2)) {
      b2 <- shift_b(f2); pBs2 <- rowSums(f2$post[, f2$bOf == b2, drop = FALSE])
      g2 <- gap(pBs2)                                                     # person-based estimate
      pPC2 <- f2$thA[[4]][, 2]; am <- which.min(pPC2); ad <- which.max(pPC2)
      pa <- sapply(1:2, function(a) sum(f2$P[f2$aOf == a]))
      g2m <- sum(f2$P[f2$aOf == am & f2$bOf == b2]) / pa[am] - sum(f2$P[f2$aOf == ad & f2$bOf == b2]) / pa[ad]  # model-based
    }
    mc4[[length(mc4) + 1]] <- data.frame(senaryo = scen4$senaryo[s], tekrar = r, gercek = gap(sm$sh),
      M = gap(shift_post4(fM, 1:8)), C = gap(shift_post4(fC, 9:16)), C2B_kisi = g2, C2B_model = g2m)
  }
  mc4 <- do.call(rbind, mc4)
  write_out(mc4, "step04_montecarlo_tekrarlar.csv")
  long <- do.call(rbind, lapply(c("M", "C", "C2B_kisi", "C2B_model"), function(m) {
    do.call(rbind, lapply(split(mc4, mc4$senaryo), function(d) {
      e <- d[[m]] - d$gercek; e <- e[!is.na(e)]
      data.frame(senaryo = d$senaryo[1], yontem = m, gercek = mean(d$gercek), ort_tahmin = mean(d[[m]], na.rm = TRUE),
                 ort_yanlilik = mean(e), medyan_yanlilik = stats::median(e), sd = stats::sd(d[[m]], na.rm = TRUE),
                 RMSE = sqrt(mean(e^2)), basarisiz_pct = 100 * mean(abs(e) > 0.25), n = length(e)) })) }))
  num <- sapply(long, is.numeric); long[num] <- lapply(long[num], round, 3)
  long$MC_R <- MC_R4
  write_out(long, "step04_montecarlo.csv")
}


# =====================================================================
# STEP05 - further checks of the two-dimensional model
#   5a. model scan (need 2-5 x compensation 2-4) and model selection
#   5b. bootstrap interval for the gradient
#   5c. external validity of compensation classes (choice of workplace, flexible work)
#   5d. subgroups: countries, employees, UK weighted
# Route A: two-dimensional EM; Route B: refit from random starts if supplied starts fail
# =====================================================================
NREP5 <- 10                                                              # observed data: number of starts
B5    <- 200                                                             # bootstrap replicates
MIN_SINIF <- 0.05                                                        # minimum marginal class share for selection

YC5 <- make_YC(w, 2); iA5 <- 1:8; iB5 <- 9:16

# gradient: cell posteriors and optional weights
grad2d <- function(ft, wt = NULL) {
  N <- nrow(ft$post); if (is.null(wt)) wt <- rep(1, N); wt[is.na(wt)] <- 0
  pPC <- ft$thA[[which(colnames(YC5)[iA5] == "N_PC")]][, 2]
  a_man <- which.min(pPC); bs <- shift_b(ft)                            # manual = class with the lowest computer need
  isM <- ft$aOf %in% a_man                                               # manual cells
  pa_m <- sum(wt * rowSums(ft$post[, isM, drop = FALSE])); pa_o <- sum(wt * rowSums(ft$post[, !isM, drop = FALSE]))
  pab_m <- sum(wt * rowSums(ft$post[, isM & ft$bOf == bs, drop = FALSE]))
  pab_o <- sum(wt * rowSums(ft$post[, !isM & ft$bOf == bs, drop = FALSE]))
  c(P_aktaran_el = pab_m / pa_m, P_aktaran_diger = pab_o / pa_o,           # manual vs all other classes
    gradyan = pab_m / pa_m - pab_o / pa_o,
    el_payi = pa_m / sum(wt), aktaran_payi = sum(wt * rowSums(ft$post[, ft$bOf == bs, drop = FALSE])) / sum(wt))
}
marg <- function(ft) list(A = sapply(seq_len(ft$Ka), function(a) sum(ft$P[ft$aOf == a])),
                          B = sapply(seq_len(ft$Kb), function(b) sum(ft$P[ft$bOf == b])))

# ---------- 5a. Model scan: all models and gradient in each ----------
RUN_5A <- !file.exists("step05_2d_uyum_genis.csv")
fits5 <- list()
if (RUN_5A) {
  rows <- list()
  for (Ka in 2:5) for (Kb in 2:4) {
    f <- tryCatch(lca2d_em(YC5, iA5, iB5, Ka, Kb, nrep = NREP5), error = function(e) NULL)
    if (is.null(f)) next
    nm <- paste0("2B_A", Ka, "_B", Kb); fits5[[nm]] <- f
    m <- marg(f); bs <- bvr_sum(bvr_fun(YC5, f)); g <- grad2d(f)
    rows[[length(rows) + 1]] <- data.frame(model = nm, Ka = Ka, Kb = Kb, LL = f$ll, npar = f$npar, BIC = f$bic,
      AIC = f$aic, entropi = entropy(f$post), en_kucuk_A = min(m$A), en_kucuk_B = min(m$B), t(bs), t(g))
  }
  all5 <- do.call(rbind, rows); all5 <- all5[order(all5$BIC), ]
  num <- sapply(all5, is.numeric); all5[num] <- lapply(all5[num], round, 4)
  write_out(all5, "step05_2d_uyum_genis.csv")                           # BIC, BVR and gradient for each model
}
all5 <- utils::read.csv("step05_2d_uyum_genis.csv", fileEncoding = "UTF-8-BOM")

# selection: first model in BIC order with all marginal classes >= 5%
choose_fit <- function() {
  i <- which(all5$en_kucuk_A >= MIN_SINIF & all5$en_kucuk_B >= MIN_SINIF)[1]
  if (is.na(i)) stop("Uygun model bulunamadi.")
  nm <- all5$model[i]
  f <- if (!is.null(fits5[[nm]])) fits5[[nm]] else lca2d_em(YC5, iA5, iB5, all5$Ka[i], all5$Kb[i], nrep = NREP5)
  list(fit = f, model = nm, sira = i)
}
RUN_5REST <- !file.exists("step05_altgrup_gradyan.csv")
if (RUN_5REST) {
  ch <- choose_fit(); f5 <- ch$fit
  sec <- data.frame(secilen_model = ch$model, BIC_sirasi = ch$sira, en_dusuk_BIC_model = all5$model[1],
                    gradyan_min_12model = min(all5$gradyan), gradyan_maks_12model = max(all5$gradyan),
                    Ka = f5$Ka, Kb = f5$Kb, t(round(grad2d(f5), 4)))
  write_out(sec, "step05_secilen_model.csv")

  # profile (selected model)
  m <- marg(f5)
  pr5 <- rbind(
    do.call(rbind, lapply(seq_along(iA5), function(q) data.frame(boyut = "A_ihtiyac", madde = colnames(YC5)[iA5[q]],
      sinif = seq_len(f5$Ka), sinif_payi = m$A, P_evet = f5$thA[[q]][, 2]))),
    do.call(rbind, lapply(seq_along(iB5), function(q) data.frame(boyut = "B_karsilama", madde = colnames(YC5)[iB5[q]],
      sinif = seq_len(f5$Kb), sinif_payi = m$B, P_evet = f5$thB[[q]][, 2]))))
  pr5$model <- ch$model; num <- sapply(pr5, is.numeric); pr5[num] <- lapply(pr5[num], round, 4)
  write_out(pr5, "step05_secilen_profil.csv")
  # joint cell probabilities
  cells <- data.frame(model = ch$model, A_sinif = f5$aOf, B_sinif = f5$bOf, P_hucre = round(f5$P, 4))
  write_out(cells, "step05_secilen_hucreler.csv")

  # ---------- 5b. Bootstrap (resample, refit) ----------
  init5 <- list(P = f5$P, thA = f5$thA, thB = f5$thB)
  bt <- list()
  for (b in seq_len(B5)) {
    set.seed(31000 + b); idx <- sample.int(nrow(YC5), replace = TRUE)
    fb <- tryCatch(lca2d_em(YC5[idx, ], iA5, iB5, f5$Ka, f5$Kb, nrep = 1, init = init5, tol = 1e-6),
                   error = function(e) NULL)                              # Route A: supplied starts
    if (is.null(fb)) fb <- tryCatch(lca2d_em(YC5[idx, ], iA5, iB5, f5$Ka, f5$Kb, nrep = 3, tol = 1e-6),
                                    error = function(e) NULL)              # Route B: random starts
    if (is.null(fb)) next
    bt[[length(bt) + 1]] <- data.frame(tekrar = b, t(grad2d(fb)))
  }
  bt <- do.call(rbind, bt)
  write_out(bt, "step05_bootstrap_tekrarlar.csv")
  g0 <- grad2d(f5)
  ci <- do.call(rbind, lapply(names(g0), function(v) data.frame(olcu = v, nokta = g0[[v]], bootstrap_ort = mean(bt[[v]]),
          SE = stats::sd(bt[[v]]), lo_2.5 = stats::quantile(bt[[v]], .025), hi_97.5 = stats::quantile(bt[[v]], .975),
          n_basarili = nrow(bt))))
  num <- sapply(ci, is.numeric); ci[num] <- lapply(ci[num], round, 4)
  write_out(ci, "step05_gradyan_ci.csv")

  # ---------- 5c. External validity of compensation (B) classes ----------
  pB <- matrix(sapply(seq_len(f5$Kb), function(b) rowSums(f5$post[, f5$bOf == b, drop = FALSE])), nrow(w), f5$Kb)
  val_vars <- c("Autonomy_Place", "Autonomy_FlexiOptions", "Job_Employed", "Country", "Occupation_SkillGroup", "Gender", "Pay_median")
  val_vars <- val_vars[val_vars %in% names(w)]
  val <- do.call(rbind, lapply(val_vars, function(v) {
    x <- as.character(w[[v]]); x[is.na(x)] <- "NA"
    do.call(rbind, lapply(sort(unique(x)), function(cat) {
      i <- x == cat
      data.frame(degisken = v, kategori = cat, N = sum(i),
                 t(setNames(100 * colSums(pB[i, , drop = FALSE]) / colSums(pB), paste0("pct_B", seq_len(f5$Kb))))) }))
  }))
  # mean choice of workplace (1-5) in each B class
  ap <- suppressWarnings(as.numeric(w$Autonomy_Place)); okp <- !is.na(ap)
  mean_ap <- sapply(seq_len(f5$Kb), function(b) sum(pB[okp, b] * ap[okp]) / sum(pB[okp, b]))
  val <- rbind(val, data.frame(degisken = "Autonomy_Place_ortalama", kategori = "1-5", N = sum(okp),
                               t(setNames(mean_ap, paste0("pct_B", seq_len(f5$Kb))))))
  num <- sapply(val, is.numeric); val[num] <- lapply(val[num], round, 3)
  write_out(val, "step05_B_sinif_dogrulama.csv")

  # ---------- 5d. Subgroups ----------
  sub_fit <- function(rows_i, lab, wt = NULL) {
    f <- tryCatch(lca2d_em(YC5[rows_i, ], iA5, iB5, f5$Ka, f5$Kb, nrep = NREP5), error = function(e) NULL)
    if (is.null(f)) return(data.frame(grup = lab, N = length(rows_i), not = "kurulamadi"))
    g <- grad2d(f, wt)
    data.frame(grup = lab, N = length(rows_i), t(round(g, 4)), not = "")
  }
  sg <- list(
    sub_fit(which(w$Country == "France"), "Fransa"),
    sub_fit(which(w$Country == "United Kingdom"), "Birlesik_Krallik"),
    sub_fit(which(!is.na(w$Job_Employed) & w$Job_Employed == 1), "Sadece_ucretli"))
  uk <- which(w$Country == "United Kingdom")
  sg[[4]] <- sub_fit(uk, "Birlesik_Krallik_agirlikli", wt = w$Weight[uk])
  # common measurement (classes fixed from the pooled model); subgroup distribution by posterior weighting
  pool_row <- function(ind, lab, wt = rep(1, nrow(w))) {
    ww <- ifelse(ind, wt, 0); ww[is.na(ww)] <- 0
    data.frame(grup = lab, N = sum(ind), t(round(grad2d(f5, ww), 4)), not = "ortak_olcum") }
  sg[[5]] <- pool_row(w$Country == "France", "Fransa_ortak_olcum")
  sg[[6]] <- pool_row(w$Country == "United Kingdom", "Birlesik_Krallik_ortak_olcum")
  sg[[7]] <- pool_row(w$Country == "United Kingdom", "Birlesik_Krallik_ortak_olcum_agirlikli", wt = w$Weight)
  sg[[8]] <- pool_row(!is.na(w$Job_Employed) & w$Job_Employed == 1, "Sadece_ucretli_ortak_olcum")
  sg <- do.call(rbind, lapply(sg, function(d) { for (v in c("P_aktaran_el", "P_aktaran_diger", "gradyan", "el_payi", "aktaran_payi"))
                                                   if (!v %in% names(d)) d[[v]] <- NA; d }))
  write_out(sg[, c("grup", "N", "P_aktaran_el", "P_aktaran_diger", "gradyan", "el_payi", "aktaran_payi", "not")],
            "step05_altgrup_gradyan.csv")
}


# =====================================================================
# STEP06 - gradient under two group definitions; tables
#   6a. refit 12 models (same seeds and solutions as step05)
#       narrow definition: single class with the lowest computer need; main: all classes with P(computer) < 0.5
#   6b. bootstrap (200), both definitions
#   6c. subgroups, both definitions
#   6d. tables (CSV)
#   6e. figures: see the end of the script
# =====================================================================
NREP6 <- 10                                                              # same as step05 (same solutions)
B6    <- 200                                                             # bootstrap replicates
THR6  <- 0.5                                                             # threshold: P(computer need) < 0.5

grad2d_v2 <- function(ft, wt = NULL, thr = THR6) {                       # main definition: all classes below the threshold
  N <- nrow(ft$post); if (is.null(wt)) wt <- rep(1, N); wt[is.na(wt)] <- 0
  pPC <- ft$thA[[which(colnames(YC5)[iA5] == "N_PC")]][, 2]
  man <- which(pPC < thr); if (!length(man)) man <- which.min(pPC)      # if none, the lowest class
  bs  <- shift_b(ft); isM <- ft$aOf %in% man
  pa_m <- sum(wt * rowSums(ft$post[, isM, drop = FALSE])); pa_o <- sum(wt * rowSums(ft$post[, !isM, drop = FALSE]))
  pab_m <- sum(wt * rowSums(ft$post[, isM & ft$bOf == bs, drop = FALSE]))
  pab_o <- sum(wt * rowSums(ft$post[, !isM & ft$bOf == bs, drop = FALSE]))
  c(P_aktaran_el = pab_m / pa_m, P_aktaran_diger = pab_o / pa_o, gradyan = pab_m / pa_m - pab_o / pa_o,
    el_payi = pa_m / sum(wt), n_el_sinif = length(man))
}
both_grad <- function(ft, wt = NULL) {                                   # both definitions side by side
  g1 <- grad2d(ft, wt); g2 <- grad2d_v2(ft, wt)
  c(gradyan_eski = g1[["gradyan"]], gradyan_yeni = g2[["gradyan"]],
    P_aktaran_el_yeni = g2[["P_aktaran_el"]], P_aktaran_diger_yeni = g2[["P_aktaran_diger"]],
    el_payi_yeni = g2[["el_payi"]], n_el_sinif = g2[["n_el_sinif"]])
}

RUN_6 <- !file.exists("step06_altgrup_gradyan.csv")
if (!RUN_6) message("step06 hesaplamalari mevcut, atlandi (tablolar ve sekiller yeniden uretilir).")
if (RUN_6) {
  # ---------- 6a. 12 models ----------
  old5 <- utils::read.csv("step05_2d_uyum_genis.csv", fileEncoding = "UTF-8-BOM")
  fits6 <- list(); r6 <- list()
  for (Ka in 2:5) for (Kb in 2:4) {
    f <- tryCatch(lca2d_em(YC5, iA5, iB5, Ka, Kb, nrep = NREP6), error = function(e) NULL)
    if (is.null(f)) next
    nm <- paste0("2B_A", Ka, "_B", Kb); fits6[[nm]] <- f
    ll5 <- old5$LL[old5$model == nm]
    r6[[length(r6) + 1]] <- data.frame(model = nm, Ka = Ka, Kb = Kb, LL = f$ll, BIC = f$bic,
      LL_step05 = if (length(ll5)) ll5 else NA, t(both_grad(f)))
  }
  r6 <- do.call(rbind, r6); r6 <- r6[order(r6$BIC), ]
  r6$ayni_cozum <- abs(r6$LL - r6$LL_step05) < 0.01                      # same as step05?
  num <- sapply(r6, is.numeric); r6[num] <- lapply(r6[num], round, 4)
  write_out(r6, "step06_12model_gradyan.csv")

  # selected model (same rule as step05)
  sel <- utils::read.csv("step05_secilen_model.csv", fileEncoding = "UTF-8-BOM")$secilen_model[1]
  f6 <- fits6[[sel]]
  if (is.null(f6)) stop("Secilen model kurulamadi: ", sel)

  # ---------- 6b. Bootstrap ----------
  init6 <- list(P = f6$P, thA = f6$thA, thB = f6$thB); bt6 <- list()
  for (b in seq_len(B6)) {
    set.seed(31000 + b); idx <- sample.int(nrow(YC5), replace = TRUE)   # same resamples as step05
    fb <- tryCatch(lca2d_em(YC5[idx, ], iA5, iB5, f6$Ka, f6$Kb, nrep = 1, init = init6, tol = 1e-6),
                   error = function(e) NULL)                              # Route A: supplied starts
