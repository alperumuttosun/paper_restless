base7 <- list(N = 2952, share = c(.7, .3), need = rbind(need_dig4, need_man4), manual = 2,
              regp = rbind(c(.85, .15), c(.5, .5)), unp = unp2, shift = 2, ld_need = list(), ld_pay = list(), rho = .7)
mod7 <- function(...) { s <- base7; a <- list(...); s[names(a)] <- a; s }
scen7 <- list(
  S5_ihtiyac_yerel_bagimlilik = mod7(ld_need = list(c(2, 3), c(6, 8))),  # safety -> clothing, internet -> workspace
  S6_odeme_yerel_bagimlilik   = mod7(ld_pay = list(c(5, 6), c(2, 3))),   # phone -> internet, safety -> clothing
  S7_uc_ihtiyac_profili       = mod7(share = c(.7, .15, .15), need = rbind(need_dig4, need_man4, need_mob7),
                                     manual = c(2, 3), regp = rbind(c(.85, .15), c(.5, .5), c(.5, .5))),
  S8_uc_karsilama_rejimi      = mod7(regp = rbind(c(.70, .15, .15), c(.30, .20, .50)), unp = unp3, shift = 3),
  S9_kucuk_orneklem           = mod7(N = 1000))
sim7 <- function(sc) {
  N <- sc$N
  prof <- sample.int(nrow(sc$need), N, replace = TRUE, prob = sc$share)  # true need profile
  reg  <- vapply(prof, function(k) sample.int(ncol(sc$regp), 1, prob = sc$regp[k, ]), 1L)  # true regime
  nd <- matrix(stats::rbinom(N * 8, 1, sc$need[prof, ]), N, 8)
  un <- matrix(stats::rbinom(N * 8, 1, sc$unp[reg, ]), N, 8)
  for (pr in sc$ld_need) { cp <- stats::rbinom(N, 1, sc$rho) == 1; nd[cp, pr[2]] <- nd[cp, pr[1]] }  # local dependence
  for (pr in sc$ld_pay)  { cp <- stats::rbinom(N, 1, sc$rho) == 1; un[cp, pr[2]] <- un[cp, pr[1]] }
  YMs <- ifelse(nd == 0, 1, un + 1); YCs <- cbind(nd + 1, ifelse(nd == 1, un + 1, NA))
  colnames(YMs) <- paste0("M", 1:8); colnames(YCs) <- c(paste0("N", 1:8), paste0("C", 1:8))
  list(man = as.integer(prof %in% sc$manual), sh = as.integer(reg == sc$shift), YM = YMs, YC = YCs)
}
