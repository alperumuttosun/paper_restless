sim9 <- function(sc) {
  N <- sc$N
  prof <- sample.int(nrow(sc$need), N, replace = TRUE, prob = sc$share)  # true need profile
  reg  <- vapply(prof, function(k) sample.int(ncol(sc$regp), 1, prob = sc$regp[k, ]), 1L)
  grp  <- stats::rbinom(N, 1, 0.5) + 1                                   # S12: two "countries"
  Pu <- t(vapply(seq_len(N), function(i) sc$unp_fun(prof[i], reg[i], grp[i]), numeric(8)))  # person-level unpaid probability
  nd <- matrix(stats::rbinom(N * 8, 1, sc$need[prof, ]), N, 8)
  un <- matrix(stats::rbinom(N * 8, 1, Pu), N, 8)
  YMs <- ifelse(nd == 0, 1, un + 1); YCs <- cbind(nd + 1, ifelse(nd == 1, un + 1, NA))
  colnames(YMs) <- paste0("M", 1:8); colnames(YCs) <- c(paste0("N", 1:8), paste0("C", 1:8))
  list(man = as.integer(prof %in% sc$manual), sh = as.integer(reg == sc$shift), YM = YMs, YC = YCs)
}
