# ---------- group definitions: low-computer-need classes ----------
man_classes <- function(ft, Y, iA, def = c("ana", "dar", "dijital"), thr = THR6) {
  def <- match.arg(def); nmA <- colnames(Y)[iA]
  pkey <- function(k) { q <- which(nmA == k); if (length(q)) ft$thA[[q]][, 2] else NULL }
  if (def == "dijital") {                                                # digital score: mean of the available digital items
    ps <- Filter(Negate(is.null), lapply(DIG_KEYS, pkey))
    sc <- Reduce(`+`, ps) / length(ps)
    man <- which(sc < thr); if (!length(man) || length(man) == ft$Ka) man <- which.min(sc)
    return(man)
  }
  pk <- pkey("N_PC"); if (is.null(pk)) pk <- pkey("N_Internet")          # internet if the computer item is dropped
  if (def == "dar") return(which.min(pk))
  man <- which(pk < thr); if (!length(man) || length(man) == ft$Ka) man <- which.min(pk)
  man
}
grad_def <- function(ft, Y, iA, def = "ana", wt = NULL) {
  N <- nrow(ft$post); if (is.null(wt)) wt <- rep(1, N); wt[is.na(wt)] <- 0
  man <- man_classes(ft, Y, iA, def); bs <- shift_b(ft); isM <- ft$aOf %in% man
  pa_m <- sum(wt * rowSums(ft$post[, isM, drop = FALSE])); pa_o <- sum(wt * rowSums(ft$post[, !isM, drop = FALSE]))
  pab_m <- sum(wt * rowSums(ft$post[, isM & ft$bOf == bs, drop = FALSE]))
  pab_o <- sum(wt * rowSums(ft$post[, !isM & ft$bOf == bs, drop = FALSE]))
  c(P_aktaran_el = pab_m / pa_m, P_aktaran_diger = pab_o / pa_o, gradyan = pab_m / pa_m - pab_o / pa_o,
    el_payi = pa_m / sum(wt), n_el_sinif = length(man))
}
grad3 <- function(ft, Y, iA, wt = NULL) {                                # three definitions side by side
  a <- grad_def(ft, Y, iA, "ana", wt); d <- grad_def(ft, Y, iA, "dar", wt); g <- grad_def(ft, Y, iA, "dijital", wt)
  c(gradyan_ana = a[["gradyan"]], P_aktaran_el = a[["P_aktaran_el"]], P_aktaran_diger = a[["P_aktaran_diger"]],
    el_payi = a[["el_payi"]], n_el_sinif = a[["n_el_sinif"]],
    gradyan_dar = d[["gradyan"]], gradyan_dijital = g[["gradyan"]], el_payi_dijital = g[["el_payi"]],
    n_el_sinif_dijital = g[["n_el_sinif"]])
}
