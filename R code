list_A <- function(id) {                                                # Route A: API via jsonlite
  js <- jsonlite::fromJSON(paste0("https://zenodo.org/api/records/", id))
  data.frame(key = js$files$key, size = js$files$size,
             checksum = js$files$checksum, url = js$files$links$self)
}
list_B <- function(id) {                                                # Route B: API via curl
  tmp <- tempfile(fileext = ".json")
  curl::curl_download(paste0("https://zenodo.org/api/records/", id), tmp)
  js <- jsonlite::fromJSON(tmp)
  data.frame(key = js$files$key, size = js$files$size, checksum = js$files$checksum,
             url = paste0("https://zenodo.org/records/", id, "/files/",
                          utils::URLencode(js$files$key, reserved = TRUE), "?download=1"))
}

