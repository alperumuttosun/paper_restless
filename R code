# ---------- 11j. S13: data generated from the 6 x 5 model ----------
if (!file.exists("step11_s13_montecarlo.csv")) {
  manT <- man_classes(f11, YC5, iA5, "ana"); bsT <- shift_b(f11)
  true_init <- list(P = f11$P, thA = f11$thA, thB = f11$thB)
  fpart <- "step11_s13_tekrarlar.csv"
  s13 <- if (file.exists(fpart)) rd(fpart) else NULL                     # resume from a previous run
  start_r <- if (is.null(s13)) 1 else max(s13$tekrar) + 1; t0 <- Sys.time()
  if (start_r <= MC_R11) for (r in start_r:MC_R11) {
    set.seed(131000 + r); N <- nrow(YC5)
    cell <- sample.int(length(f11$P), N, replace = TRUE, prob = f11$P); a <- f11$aOf[cell]; b <- f11$bOf[cell]
    nd <- sapply(seq_along(tools), function(j) stats::rbinom(N, 1, f11$thA[[j]][a, 2]))
    un <- sapply(seq_along(tools), function(j) stats::rbinom(N, 1, f11$thB[[j]][b, 2]))
    YCs <- cbind(nd + 1, ifelse(nd == 1, un + 1, NA)); colnames(YCs) <- colnames(YC5)
    YMs <- ifelse(nd == 0, 1, un + 1); colnames(YMs) <- paste0("M_", tools)
    man <- a %in% manT; sh <- b == bsT; gap <- function(p) mean(p[man]) - mean(p[!man])
    fr <- tryCatch(lca2d_em(YCs, iA5, iB5, KA11, KB11, nrep = NREP11), error = function(e) NULL)                 # Route B: random
    ft <- tryCatch(lca2d_em(YCs, iA5, iB5, KA11, KB11, nrep = 1, init = true_init), error = function(e) NULL)    # Route A: true values
    fM <- run_lca(YMs, 2, 5); fC <- run_lca(YCs, 4, 5)
    g2 <- function(f) if (is.null(f)) c(NA, NA) else c(grad_def(f, YCs, iA5, "ana")[["gradyan"]],
                                                       gap(rowSums(f$post[, f$bOf == shift_b(f), drop = FALSE])))
    row <- data.frame(tekrar = r, gercek = gap(sh),
      gercek_model = sum(f11$P[f11$aOf %in% manT & f11$bOf == bsT]) / sum(f11$P[f11$aOf %in% manT]) -
                     sum(f11$P[!(f11$aOf %in% manT) & f11$bOf == bsT]) / sum(f11$P[!(f11$aOf %in% manT)]),
