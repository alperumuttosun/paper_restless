# ---------- two-dimensional EM ----------
lca2d_em <- function(Y, idxA, idxB, Ka, Kb, nrep = 10, maxit = 3000, tol = 1e-7, seed0 = 2000, init = NULL) {
  Y <- as.matrix(Y); N <- nrow(Y); R <- apply(Y, 2, max, na.rm = TRUE)
  C <- Ka * Kb; aOf <- rep(seq_len(Ka), times = Kb); bOf <- rep(seq_len(Kb), each = Ka)  # cell -> (a, b)
  upd <- function(pp, idx, K) lapply(idx, function(j) {                  # M step: item probabilities
    y <- Y[, j]; ok <- !is.na(y)
    m <- sapply(seq_len(R[j]), function(cc) colSums(pp[ok & y == cc, , drop = FALSE]))
    m <- matrix(m, K, R[j]) + 1e-10; m / rowSums(m) })
  best <- NULL
  for (r in seq_len(nrep)) {
    set.seed(seed0 + r)
    pc  <- rep(1 / C, C)                                                 # joint cell probabilities
    thA <- lapply(idxA, function(j) { m <- matrix(stats::runif(Ka * R[j]), Ka, R[j]); m / rowSums(m) })
    thB <- lapply(idxB, function(j) { m <- matrix(stats::runif(Kb * R[j]), Kb, R[j]); m / rowSums(m) })
    if (r == 1 && !is.null(init)) { pc <- init$P; thA <- init$thA; thB <- init$thB }  # user-supplied start values (for bootstrap)
    ll_old <- -Inf
    for (it in seq_len(maxit)) {
      LA <- matrix(0, N, Ka); LB <- matrix(0, N, Kb)                      # log-likelihood by dimension
      for (q in seq_along(idxA)) { y <- Y[, idxA[q]]; ok <- !is.na(y)
        LA[ok, ] <- LA[ok, ] + t(log(thA[[q]][, y[ok], drop = FALSE])) }
      for (q in seq_along(idxB)) { y <- Y[, idxB[q]]; ok <- !is.na(y)
        LB[ok, ] <- LB[ok, ] + t(log(thB[[q]][, y[ok], drop = FALSE])) }
      lp <- LA[, aOf, drop = FALSE] + LB[, bOf, drop = FALSE] + matrix(log(pc), N, C, byrow = TRUE)
      mx <- apply(lp, 1, max); ll <- sum(mx + log(rowSums(exp(lp - mx))))
      post <- exp(lp - mx); post <- post / rowSums(post)                 # E step
      pc <- colMeans(post)
      pA <- matrix(sapply(seq_len(Ka), function(a) rowSums(post[, aOf == a, drop = FALSE])), N, Ka)
      pB <- matrix(sapply(seq_len(Kb), function(b) rowSums(post[, bOf == b, drop = FALSE])), N, Kb)
      thA <- upd(pA, idxA, Ka); thB <- upd(pB, idxB, Kb)
      if (abs(ll - ll_old) < tol) break; ll_old <- ll
    }
    if (is.null(best) || ll > best$ll) best <- list(ll = ll, P = pc, post = post, thA = thA, thB = thB)
  }
  npar <- (C - 1) + Ka * sum(R[idxA] - 1) + Kb * sum(R[idxB] - 1)
  best$npar <- npar; best$bic <- -2 * best$ll + log(N) * npar; best$aic <- -2 * best$ll + 2 * npar
  best$Ka <- Ka; best$Kb <- Kb; best$aOf <- aOf; best$bOf <- bOf; best$idxA <- idxA; best$idxB <- idxB
  thc <- vector("list", ncol(Y))                                          # item probabilities by cell
  for (q in seq_along(idxA)) thc[[idxA[q]]] <- best$thA[[q]][aOf, , drop = FALSE]
  for (q in seq_along(idxB)) thc[[idxB[q]]] <- best$thB[[q]][bOf, , drop = FALSE]
  best$th <- thc; best$yol <- "A_2boyutluEM"; best
}

